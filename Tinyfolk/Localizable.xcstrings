          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        }
      }
    },
    "Cosmo, Tuck, Kumo and Lumen, each with their own dance.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosmo, Tuck, Kumo ve Lumen, her birinin kendi dansıyla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosmo, Tuck, Kumo y Lumen, cada uno con su propio baile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosmo, Tuck, Kumo e Lumen, cada um com sua própria dança."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosmo, Tuck, Kumo und Lumen, jeder mit eigenem Tanz."
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    },
    "Every piece is played live on your device by a small synthesizer. The cast dances to the beat.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her parça cihazında küçük bir sentezleyiciyle canlı çalınır. Karakterler ritme göre dans eder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pieza suena en vivo en tu dispositivo con un pequeño sintetizador. Los personajes bailan al ritmo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada música é tocada ao vivo no seu aparelho por um pequeno sintetizador. Os personagens dançam no ritmo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Stück wird live auf deinem Gerät von einem kleinen Synthesizer gespielt. Die Figuren tanzen im Takt."
          }
        }
      }
    },
    "Everything you have now stays free forever.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an sahip olduğun her şey sonsuza dek ücretsiz kalır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que tienes ahora sigue gratis para siempre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você já tem continua grátis para sempre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du jetzt hast, bleibt für immer kostenlos."
          }
        }
      }
    },

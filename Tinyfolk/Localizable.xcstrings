          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bossa Lumen, Greensleeves, The Entertainer und Wiegenlied."
          }
        }
      }
    },
    "Capture your tiny friend and share the clip.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük arkadaşını kaydet ve videoyu paylaş."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba a tu pequeño amigo y comparte el clip."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave o seu amiguinho e compartilhe o vídeo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm deinen kleinen Freund auf und teile den Clip."
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",

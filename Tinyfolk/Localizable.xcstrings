            "value": "Visão 3D"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3D-Ansicht"
          }
        }
      }
    },
    "A second person walking up gets a wave.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanına ikinci biri gelince el sallar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se acerca una segunda persona, la saluda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma segunda pessoa chega, ganha um aceno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt eine zweite Person dazu, wird gewinkt."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakkında"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca de"

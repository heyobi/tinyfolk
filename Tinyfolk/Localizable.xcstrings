            "value": "Sobre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über"
          }
        }
      }
    },
    "Allow the camera in Settings": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'da kameraya izin ver"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir la cámara en Ajustes"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir a câmera nos Ajustes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera in den Einstellungen erlauben"
          }
        }
      }
    },
    "Bossa Lumen, Greensleeves, The Entertainer and Wiegenlied.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bossa Lumen, Greensleeves, The Entertainer ve Wiegenlied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
